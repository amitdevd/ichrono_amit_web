{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      "@ichrono/theme": [
        "./packages/theme/src/index.ts"
      ],
      "@ichrono/theme/*": [
        "./packages/theme/src/*"
      ],
      "@ichrono/ui": [
        "./packages/ui/src/index.ts"
      ],
      "@ichrono/ui/*": [
        "./packages/ui/src/*"
      ],
      "@ichrono/auth": [
        "./packages/auth/src/index.tsx"
      ],
      "@ichrono/auth/*": [
        "./packages/auth/src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "apps/**/*.ts",
    "apps/**/*.tsx"
  ]
}
